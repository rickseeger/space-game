; Engine configuration file.
; Godot 4.3 space combat game — Space Hawk

config_version=5

[application]

config/name="Space Hawk"
config/description="Keyboard-driven space combat — fly, fight, hyperspace."
config/version="1.0.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InputBootstrap="*res://scripts/autoload/input_bootstrap.gd"
GameState="*res://scripts/autoload/game_state.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
AudioFx="*res://scripts/autoload/audio_fx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

